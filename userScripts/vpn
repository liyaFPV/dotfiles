check_argument() {
    local arg=$(echo "$1" | tr '[:upper:]' '[:lower:]')
    case "$arg" in
        0|off)
            vpn_off
            ;;
        1|on)
            vpn_on
            ;;
        "")
            echo "Ошибка: аргумент не передан!"
            echo "Использование: $0 [0|1|on|off]"
            return 1
            ;;
        *)
            echo "Ошибка: неверный аргумент '$1'!"
            echo "Допустимые значения: 0, 1, on, off"
            return 1
            ;;
    esac
}

